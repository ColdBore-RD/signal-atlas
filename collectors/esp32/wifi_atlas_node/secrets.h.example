// Copy this file to secrets.h and fill in the values. secrets.h is git-ignored.
// Never commit real values. The values come from the password manager.
#pragma once

// The Wi-Fi network this node joins to reach the MQTT broker.
#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-wifi-password"

// MQTT broker. Give each node its own account that may only publish to
// sensors/wifi-atlas/<node-id>/# .
#define MQTT_HOST     "192.0.2.1"
#define MQTT_PORT     1883
#define MQTT_USER     "wifi-atlas-node"
#define MQTT_PASSWORD "your-mqtt-password"

// Optional. Without NODE_ID the id is "esp32-" plus the last three bytes of the MAC address.
// #define NODE_ID "esp32-kitchen"

// Optional. Time between scans (milliseconds) and the time server.
// #define SCAN_INTERVAL_MS 5000UL
// #define NTP_SERVER "pool.ntp.org"
