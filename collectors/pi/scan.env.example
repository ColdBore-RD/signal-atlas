# Example settings for collectors/pi/scan.py. Copy to /etc/wifi-atlas/scan.env and fill in.
# The addresses below are documentation examples, not real hosts.
ATLAS_NODE_ID=pi-500
ATLAS_IFACE=wlan0
ATLAS_SCAN_INTERVAL_S=10
ATLAS_OUT=/var/lib/wifi-atlas/samples.pi.ndjson
ATLAS_MQTT_HOST=192.0.2.1
ATLAS_MQTT_PORT=1883
ATLAS_MQTT_USER=wifi-atlas-pi-500
ATLAS_MQTT_PASSWORD=change-me
ATLAS_PROBE_TARGETS=home-server=192.0.2.10,nas=192.0.2.11
ATLAS_PROBE_INTERVAL_S=60
ATLAS_IPERF3=0
